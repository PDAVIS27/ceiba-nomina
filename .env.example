# Cadena de conexión a la base de datos (Postgres).
# Si usas Vercel Postgres o Neon, Vercel la agrega automáticamente
# al conectar el "Storage" de tu proyecto — no la escribas a mano.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos"

# Genera esto UNA vez y no lo compartas. En tu terminal (o en
# https://generate-secret.vercel.app/32) genera un valor aleatorio.
NEXTAUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"

# La URL pública de tu sitio ya desplegado, ej: https://ceiba-nomina.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Para "Enviar por correo" (pre-nómina/nómina) en Históricos — crea una
# cuenta gratis en https://resend.com y genera una API key.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente de esos correos. Mientras no verifiques tu propio dominio en
# Resend (Domains → Add Domain), SOLO puedes enviar a la casilla con la que
# creaste la cuenta de Resend, y debes dejar este valor como está abajo. Una
# vez verificado tu dominio (10-15 min, gratis), cámbialo por algo como
# "Ceiba <nomina@tudominio.com>" para poder enviar a cualquier cliente.
RESEND_FROM_EMAIL="Ceiba <onboarding@resend.dev>"
