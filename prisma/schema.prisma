// Esquema de base de datos de Ceiba.
// Motor: PostgreSQL (funciona directo con Vercel Postgres / Neon).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROVIDER_ADMIN // tú, como proveedor de la plataforma
  COMPANY_OWNER  // el negocio cliente (RRHH / dueño)
}

// Motivo de baja de un colaborador. Determina si corresponde indemnización
// por antigüedad (Art. 45 CT): normalmente SOLO en despido sin causa
// justificada u otra causa ajena a la voluntad del trabajador — no en
// renuncia voluntaria ni en despido con justa causa (Art. 48 CT).
enum TerminationType {
  RENUNCIA             // no aplica indemnización por antigüedad
  DESPIDO_JUSTA_CAUSA   // no aplica indemnización por antigüedad
  DESPIDO_SIN_CAUSA     // sí aplica indemnización por antigüedad
  OTRA_CAUSA_AJENA      // (mutuo acuerdo, cierre del negocio, etc.) sí aplica
}

// Tipo de provisión que puede "pagarse" o "disfrutarse" antes de la baja,
// reduciendo el saldo acumulado (aguinaldo pagado en diciembre, vacaciones
// tomadas durante el año). La indemnización no tiene movimientos: solo se
// liquida una vez, al dar de baja.
enum ProvisionTipo {
  AGUINALDO
  VACACIONES
}

// Distingue una planilla normal de un pago especial de aguinaldo (diciembre).
// Un período AGUINALDO no acumula provisiones nuevas — solo paga el saldo de
// aguinaldo acumulado (exento de INSS/IR) y, al aprobarse, registra el pago
// (ProvisionMovement) para descontarlo del saldo de cada colaborador.
enum TipoPeriodo {
  NOMINA
  AGUINALDO
}

// Figura fiscal con la que el negocio cliente está inscrito ante la DGI.
// Es un dato informativo/documental — NO cambia el cálculo de IR laboral de
// sus colaboradores: ese impuesto depende del salario de cada trabajador
// (Art. 23, Ley 822) y de la relación de subordinación, no del régimen del
// empleador. Cuota Fija, por ejemplo, sustituye el IR y el IVA del NEGOCIO
// (persona natural, ingresos ≤ C$100,000/mes) — no exime a sus trabajadores
// del IR laboral si su salario supera el umbral exento.
enum RegimenFiscal {
  GENERAL      // régimen general de rentas de actividades económicas
  CUOTA_FIJA   // persona natural, pequeño contribuyente (DGI)
  ZONA_FRANCA  // empresa exonerada de IR bajo régimen de zona franca
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Company {
  id             String          @id @default(cuid())
  name           String
  // Usado para decidir la tasa de INSS patronal (21.5% / 22.5%).
  status         String          @default("PILOTO") // PILOTO, ACTIVO, PAUSADO
  // Solo informativo — ver comentario de RegimenFiscal. No afecta el cálculo
  // de nómina.
  regimenFiscal  RegimenFiscal   @default(GENERAL)
  createdAt      DateTime        @default(now())
  users          User[]
  employees      Employee[]
  periods        PayrollPeriod[]
  supportCases   SupportCase[]
}

model Employee {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  externalCode String?
  cedula       String?
  cuentaBancaria String?
  fullName     String
  role         String
  grossSalary  Decimal    @db.Decimal(12, 2)
  startDate    DateTime   @default(now())
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  payslips     Payslip[]

  // Baja del colaborador — se llenan al usar "Dar de baja".
  terminatedAt     DateTime?
  terminationType  TerminationType?
  terminationNote  String?

  provisionMovements ProvisionMovement[]
  liquidacion         Liquidacion?

  @@unique([companyId, externalCode])
}

model PayrollPeriod {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id])
  label      String
  status     String     @default("BORRADOR") // BORRADOR (pendiente de aprobación) | APROBADA (final)
  tipo       TipoPeriodo @default(NOMINA)
  createdAt  DateTime   @default(now())
  approvedAt DateTime?
  payslips   Payslip[]

  // Fecha real que cubre este período (no solo el nombre libre de "label").
  // Nulas en períodos creados antes de este campo — el histórico de
  // provisiones cae de vuelta a createdAt para esos casos (ver provisiones.ts).
  periodStart DateTime?
  periodEnd   DateTime?
}

model Payslip {
  id             String        @id @default(cuid())
  periodId       String
  period         PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  grossSalary    Decimal       @db.Decimal(12, 2)
  horasExtraCantidad     Decimal @default(0) @db.Decimal(6, 2)
  horasExtraMonto        Decimal @default(0) @db.Decimal(12, 2)
  comisiones             Decimal @default(0) @db.Decimal(12, 2)
  retroactivos           Decimal @default(0) @db.Decimal(12, 2)
  viaticos               Decimal @default(0) @db.Decimal(12, 2)
  provisionAguinaldo     Decimal @default(0) @db.Decimal(12, 2)
  provisionVacaciones    Decimal @default(0) @db.Decimal(12, 2)
  provisionIndemnizacion Decimal @default(0) @db.Decimal(12, 2)
  // Descuento adicional que decide el negocio, sin base legal (error de pago,
  // falta, llegada tardía, etc.) — se resta del neto a pagar, pero NO forma
  // parte de la base gravable de INSS/IR (esas retenciones son solo de ley).
  otrasDeducciones        Decimal @default(0) @db.Decimal(12, 2)
  otrasDeduccionesConcepto String?
  inssLaboral    Decimal       @db.Decimal(12, 2)
  irMensual      Decimal       @db.Decimal(12, 2)
  netPay         Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
}

// Casos que la plataforma marca para que el proveedor (tú) intervenga a mano:
// salario variable, aguinaldo que excede el tramo exento, doble empleador, etc.
model SupportCase {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  // Categoría elegida por el negocio al reportar (ver src/lib/supportCategories.ts)
  // — ayuda a clasificar de un vistazo qué tipo de caso es. Null en casos
  // creados antes de este campo.
  category  String?
  title     String
  detail    String
  resolved  Boolean  @default(false)
  // Respuesta del proveedor al resolver el caso — el negocio la ve desde su
  // panel, para saber qué se hizo o qué debe corregir. Solo el proveedor
  // puede escribirla (se llena desde /admin).
  providerNote String?
  createdAt DateTime @default(now())
}

// Histórico de provisiones "pagadas" o "disfrutadas" fuera de la nómina
// normal: aguinaldo pagado en diciembre, vacaciones tomadas durante el año.
// Reduce el saldo acumulado que se calcula sumando los Payslip aprobados.
model ProvisionMovement {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  tipo       ProvisionTipo
  amount     Decimal       @db.Decimal(12, 2)
  dias       Decimal?      @db.Decimal(6, 2) // solo informativo para VACACIONES
  fecha      DateTime      @default(now())
  note       String?
  createdAt  DateTime      @default(now())
}

// Liquidación final calculada al dar de baja a un colaborador — queda como
// comprobante fijo de lo que se calculó en ese momento (no se recalcula
// después, aunque cambien las tasas de ley más adelante).
model Liquidacion {
  id                   String          @id @default(cuid())
  employeeId           String          @unique
  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId            String
  terminationType      TerminationType
  terminatedAt         DateTime
  antiguedadMeses      Int
  aguinaldoPendiente   Decimal         @db.Decimal(12, 2) // exento de INSS/IR (Art. 97 CT) — se paga íntegro
  vacacionesPendientes Decimal         @db.Decimal(12, 2) // bruto — informativo, forma parte de la base gravable de abajo

  // Horas extra pendientes de pagar (Art. 62/65 CT, recargo del 100%) —
  // informativo (cantidad + monto ya calculado), el monto forma parte de la
  // base gravable de abajo, igual que vacaciones y pagos pendientes.
  horasExtraCantidad Decimal @default(0) @db.Decimal(12, 2)
  horasExtraMonto    Decimal @default(0) @db.Decimal(12, 2)

  aplicaIndemnizacion  Boolean
  indemnizacion        Decimal         @db.Decimal(12, 2) // exenta de INSS/IR (Art. 45 CT) — se paga íntegra

  // Salarios pendientes de pago al momento de la baja (quincena no pagada,
  // mes adicional, comisiones, etc. — ver LiquidacionPagoPendiente).
  pagosPendientes    LiquidacionPagoPendiente[]

  // Base gravable de la liquidación: vacacionesPendientes + horasExtraMonto +
  // la suma de todos los pagosPendientes (aguinaldo e indemnización quedan
  // FUERA porque están exentos de ley). El INSS laboral (7%) y el IR
  // (Art. 23, Ley 822) se calculan UNA sola vez sobre este total combinado —
  // no por separado — porque se pagan juntos en el mismo cheque de liquidación.
  gravableBruto Decimal @default(0) @db.Decimal(12, 2)
  gravableInss  Decimal @default(0) @db.Decimal(12, 2)
  gravableIr    Decimal @default(0) @db.Decimal(12, 2)
  gravableNeto  Decimal @default(0) @db.Decimal(12, 2)

  totalIngresos        Decimal         @default(0) @db.Decimal(12, 2) // aguinaldo + vacaciones + indemnización + pagos pendientes, todo bruto
  total                Decimal         @db.Decimal(12, 2) // lo que de verdad se le paga (neto)
  note                 String?
  createdAt            DateTime        @default(now())
}

// Un concepto individual de pago pendiente dentro de una liquidación (ej.
// "Quincena 1-15 sept", "Comisión de agosto", "Mes adicional"). El monto
// bruto de cada uno se guarda por separado para mostrarlo desglosado, pero
// la retención de ley se calcula sobre la SUMA de todos (ver Liquidacion).
model LiquidacionPagoPendiente {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  concepto      String
  monto         Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
}
