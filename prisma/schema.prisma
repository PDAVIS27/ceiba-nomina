// Esquema de base de datos de Ceiba.
// Motor: PostgreSQL (funciona directo con Vercel Postgres / Neon).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROVIDER_ADMIN // tú, como proveedor de la plataforma
  COMPANY_OWNER  // el negocio cliente (RRHH / dueño)
}

// Motivo de baja de un colaborador. Determina si corresponde indemnización
// por antigüedad (Art. 45 CT): normalmente SOLO en despido sin causa
// justificada u otra causa ajena a la voluntad del trabajador — no en
// renuncia voluntaria ni en despido con justa causa (Art. 48 CT).
enum TerminationType {
  RENUNCIA             // no aplica indemnización por antigüedad
  DESPIDO_JUSTA_CAUSA   // no aplica indemnización por antigüedad
  DESPIDO_SIN_CAUSA     // sí aplica indemnización por antigüedad
  OTRA_CAUSA_AJENA      // (mutuo acuerdo, cierre del negocio, etc.) sí aplica
}

// Tipo de provisión que puede "pagarse" o "disfrutarse" antes de la baja,
// reduciendo el saldo acumulado (aguinaldo pagado en diciembre, vacaciones
// tomadas durante el año). La indemnización no tiene movimientos: solo se
// liquida una vez, al dar de baja.
enum ProvisionTipo {
  AGUINALDO
  VACACIONES
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Company {
  id             String          @id @default(cuid())
  name           String
  // Usado para decidir la tasa de INSS patronal (21.5% / 22.5%).
  status         String          @default("PILOTO") // PILOTO, ACTIVO, PAUSADO
  createdAt      DateTime        @default(now())
  users          User[]
  employees      Employee[]
  periods        PayrollPeriod[]
  supportCases   SupportCase[]
}

model Employee {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  externalCode String?
  fullName     String
  role         String
  grossSalary  Decimal    @db.Decimal(12, 2)
  startDate    DateTime   @default(now())
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  payslips     Payslip[]

  // Baja del colaborador — se llenan al usar "Dar de baja".
  terminatedAt     DateTime?
  terminationType  TerminationType?
  terminationNote  String?

  provisionMovements ProvisionMovement[]
  liquidacion         Liquidacion?

  @@unique([companyId, externalCode])
}

model PayrollPeriod {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id])
  label      String
  status     String     @default("BORRADOR") // BORRADOR (pendiente de aprobación) | APROBADA (final)
  createdAt  DateTime   @default(now())
  approvedAt DateTime?
  payslips   Payslip[]
}

model Payslip {
  id             String        @id @default(cuid())
  periodId       String
  period         PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  grossSalary    Decimal       @db.Decimal(12, 2)
  horasExtraCantidad     Decimal @default(0) @db.Decimal(6, 2)
  horasExtraMonto        Decimal @default(0) @db.Decimal(12, 2)
  comisiones             Decimal @default(0) @db.Decimal(12, 2)
  retroactivos           Decimal @default(0) @db.Decimal(12, 2)
  viaticos               Decimal @default(0) @db.Decimal(12, 2)
  provisionAguinaldo     Decimal @default(0) @db.Decimal(12, 2)
  provisionVacaciones    Decimal @default(0) @db.Decimal(12, 2)
  provisionIndemnizacion Decimal @default(0) @db.Decimal(12, 2)
  inssLaboral    Decimal       @db.Decimal(12, 2)
  irMensual      Decimal       @db.Decimal(12, 2)
  netPay         Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
}

// Casos que la plataforma marca para que el proveedor (tú) intervenga a mano:
// salario variable, aguinaldo que excede el tramo exento, doble empleador, etc.
model SupportCase {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  title     String
  detail    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Histórico de provisiones "pagadas" o "disfrutadas" fuera de la nómina
// normal: aguinaldo pagado en diciembre, vacaciones tomadas durante el año.
// Reduce el saldo acumulado que se calcula sumando los Payslip aprobados.
model ProvisionMovement {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  tipo       ProvisionTipo
  amount     Decimal       @db.Decimal(12, 2)
  dias       Decimal?      @db.Decimal(6, 2) // solo informativo para VACACIONES
  fecha      DateTime      @default(now())
  note       String?
  createdAt  DateTime      @default(now())
}

// Liquidación final calculada al dar de baja a un colaborador — queda como
// comprobante fijo de lo que se calculó en ese momento (no se recalcula
// después, aunque cambien las tasas de ley más adelante).
model Liquidacion {
  id                   String          @id @default(cuid())
  employeeId           String          @unique
  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId            String
  terminationType      TerminationType
  terminatedAt         DateTime
  antiguedadMeses      Int
  aguinaldoPendiente   Decimal         @db.Decimal(12, 2)
  vacacionesPendientes Decimal         @db.Decimal(12, 2)
  aplicaIndemnizacion  Boolean
  indemnizacion        Decimal         @db.Decimal(12, 2)
  total                Decimal         @db.Decimal(12, 2)
  note                 String?
  createdAt            DateTime        @default(now())
}
